  "story": {
    "headline": "A `;` segment in the last part of a path now survives into the digest `uri` and its hash.",
    "beats": [
      {
        "label": "Before",
        "text": "`build_digest_header` rebuilt the request-URI from `.path` and `.query` only."
      },
      {
        "label": "Why",
        "text": "`urlparse` moves the last segment's `;name=x` into `.params`, which nothing read."
      },
      {
        "label": "Now",
        "text": "`.params` is appended before the query, so `uri=` and `A2` both carry it."
      }
    ],

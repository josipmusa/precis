diff --git a/src/meridian/refunds/policy.py b/src/meridian/refunds/policy.py
new file mode 100644
index 0000000..2d0ad56
--- /dev/null
+++ b/src/meridian/refunds/policy.py
@@ -0,0 +1,58 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from meridian.config import limits
+
+
+class RefundNotAllowed(Exception):
+    """Raised when a requested refund exceeds what the order permits."""
+
+
+@dataclass(frozen=True)
+class RefundAllowance:
+    """What is still refundable on an order, and why."""
+
+    order_id: str
+    refundable_cents: int
+    refunds_so_far: int
+
+    @property
+    def exhausted(self) -> bool:
+        return self.refundable_cents == 0
+
+
+class RefundPolicy:
+    """Decides whether a requested refund amount is permitted.
+
+    Two rules, both cumulative over the life of the order:
+
+      1. the sum of refunds may never exceed the order total
+      2. an order may not be refunded more times than limits.max_refunds_per_order
+    """
+
+    def __init__(self, max_refunds_per_order: int | None = None) -> None:
+        self._max_refunds = max_refunds_per_order or limits.orders.max_refunds_per_order
+
+    def allowance(self, total_cents: int, refunded_cents: int, refund_count: int) -> RefundAllowance:
+        remaining = max(total_cents - refunded_cents, 0)
+        if refund_count >= self._max_refunds:
+            remaining = 0
+        return RefundAllowance(
+            order_id="",
+            refundable_cents=remaining,
+            refunds_so_far=refund_count,
+        )
+
+    def check(self, amount_cents: int, allowance: RefundAllowance) -> None:
+        if amount_cents <= 0:
+            raise RefundNotAllowed("refund amount must be positive")
+        if allowance.refunds_so_far >= self._max_refunds:
+            raise RefundNotAllowed(
+                f"order already refunded {allowance.refunds_so_far} times "
+                f"(limit {self._max_refunds})"
+            )
+        if amount_cents > allowance.refundable_cents:
+            raise RefundNotAllowed(
+                f"refund of {amount_cents} exceeds remaining {allowance.refundable_cents}"
+            )

@@ -0,0 +1,59 @@
+from __future__ import annotations
+
+from fastapi import APIRouter, Depends, HTTPException
+
+from meridian.api.schemas.refund import RefundRequest, RefundResponse
+from meridian.auth import Principal, require_scope
+from meridian.orders.repository import OrderRepository
+from meridian.payments.stripe_gateway import StripeGateway
+from meridian.refunds.ledger import RefundLedger
+from meridian.refunds.policy import RefundNotAllowed
+
+router = APIRouter(prefix="/orders", tags=["refunds"])
+
+
+@router.post("/{order_id}/refunds", response_model=RefundResponse, status_code=201)
+def create_refund(
+    order_id: str,
+    body: RefundRequest,
+    principal: Principal = Depends(require_scope("refunds:write")),
+    orders: OrderRepository = Depends(OrderRepository),
+    ledger: RefundLedger = Depends(RefundLedger),
+    gateway: StripeGateway = Depends(StripeGateway),
+) -> RefundResponse:
+    """Refund an order, in full or in part.
+
+    Omitting `amount_cents` refunds everything still refundable, which keeps
+    the previous console behaviour available over the API.
+    """
+    order = orders.get(order_id)
+    if order is None:
+        raise HTTPException(status_code=404, detail="order not found")
+
+    amount = body.amount_cents
+    if amount is None:
+        amount = order.total_cents - order.refunded_cents
+
+    provider_refund_id = gateway.refund(
+        charge_id=order.charge_id,
+        order_id=order_id,
+        amount_cents=amount,
+    )
+
+    try:
+        record = ledger.record_refund(
+            order_id=order_id,
+            amount_cents=amount,
+            currency=order.currency,
+            provider_refund_id=provider_refund_id,
+        )
+    except RefundNotAllowed as exc:
+        raise HTTPException(status_code=409, detail=str(exc)) from exc
+
+    return RefundResponse(
+        id=provider_refund_id,
+        order_id=record.order_id,
+        amount_cents=record.amount_cents,
+        currency=record.currency,
+        provider_refund_id=record.provider_refund_id,
+    )

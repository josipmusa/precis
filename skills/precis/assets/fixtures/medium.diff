@@ -0,0 +1,59 @@
+import pytest
+
+from tests.factories import make_order
+
+
+@pytest.fixture()
+def order(db):
+    return make_order(db, total_cents=10_000, currency="usd", status="paid")
+
+
+def test_partial_refund_returns_201_and_the_amount(client, order):
+    response = client.post(
+        f"/orders/{order.id}/refunds",
+        json={"amount_cents": 2_500, "reason": "damaged in transit"},
+        scopes=["refunds:write"],
+    )
+
+    assert response.status_code == 201
+    assert response.json()["amount_cents"] == 2_500
+
+
+def test_omitting_the_amount_refunds_the_remainder(client, order):
+    client.post(f"/orders/{order.id}/refunds", json={"amount_cents": 4_000}, scopes=["refunds:write"])
+
+    response = client.post(f"/orders/{order.id}/refunds", json={}, scopes=["refunds:write"])
+
+    assert response.status_code == 201
+    assert response.json()["amount_cents"] == 6_000
+
+
+def test_order_becomes_partially_refunded_then_refunded(client, order, orders_repo):
+    client.post(f"/orders/{order.id}/refunds", json={"amount_cents": 4_000}, scopes=["refunds:write"])
+    assert orders_repo.get(order.id).status == "partially_refunded"
+
+    client.post(f"/orders/{order.id}/refunds", json={"amount_cents": 6_000}, scopes=["refunds:write"])
+    assert orders_repo.get(order.id).status == "refunded"
+
+
+def test_refunding_more_than_the_total_is_a_conflict(client, order):
+    client.post(f"/orders/{order.id}/refunds", json={"amount_cents": 9_000}, scopes=["refunds:write"])
+
+    response = client.post(
+        f"/orders/{order.id}/refunds",
+        json={"amount_cents": 2_000},
+        scopes=["refunds:write"],
+    )
+
+    assert response.status_code == 409
+    assert "exceeds remaining" in response.json()["detail"]
+
+
+def test_requires_the_refunds_write_scope(client, order):
+    response = client.post(
+        f"/orders/{order.id}/refunds",
+        json={"amount_cents": 100},
+        scopes=["orders:read"],
+    )
+
+    assert response.status_code == 403
diff --git a/tests/refunds/test_policy.py b/tests/refunds/test_policy.py
new file mode 100644
index 0000000..f626244
--- /dev/null
+++ b/tests/refunds/test_policy.py
@@ -0,0 +1,44 @@
+import pytest
+
+from meridian.refunds.policy import RefundNotAllowed, RefundPolicy
+
+
+@pytest.fixture()
+def policy():
+    return RefundPolicy(max_refunds_per_order=3)
+
+
+def test_allowance_is_the_unrefunded_remainder(policy):
+    allowance = policy.allowance(total_cents=10_000, refunded_cents=2_500, refund_count=1)
+
+    assert allowance.refundable_cents == 7_500
+    assert not allowance.exhausted
+
+
+def test_allowance_is_zero_once_the_count_limit_is_reached(policy):
+    allowance = policy.allowance(total_cents=10_000, refunded_cents=100, refund_count=3)
+
+    assert allowance.refundable_cents == 0
+    assert allowance.exhausted
+
+
+def test_refund_above_the_remainder_is_rejected(policy):
+    allowance = policy.allowance(total_cents=10_000, refunded_cents=9_000, refund_count=1)
+
+    with pytest.raises(RefundNotAllowed, match="exceeds remaining"):
+        policy.check(1_001, allowance)
+
+
+def test_refund_equal_to_the_remainder_is_allowed(policy):
+    allowance = policy.allowance(total_cents=10_000, refunded_cents=9_000, refund_count=1)
+
+    policy.check(1_000, allowance)
+
+
+def test_zero_and_negative_amounts_are_rejected(policy):
+    allowance = policy.allowance(total_cents=10_000, refunded_cents=0, refund_count=0)
+
+    with pytest.raises(RefundNotAllowed, match="must be positive"):
+        policy.check(0, allowance)
+    with pytest.raises(RefundNotAllowed, match="must be positive"):
+        policy.check(-50, allowance)

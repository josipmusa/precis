new file mode 100644
index 0000000..62c71e8
--- /dev/null
+++ b/src/meridian/webhooks/dedupe.py
@@ -0,0 +1,44 @@
+"""Single-delivery guard for inbound webhook events.
+
+Stripe retries a delivery until it receives a 2xx, and it does not
+guarantee that the previous attempt failed. Any handler with a side
+effect has to claim the event id before performing it.
+"""
+
+from __future__ import annotations
+
+import logging
+
+from meridian.db import Pool
+
+log = logging.getLogger(__name__)
+
+_CLAIM = """
+INSERT INTO webhook_events (event_id, provider, claimed_at)
+VALUES (%s, %s, now())
+ON CONFLICT (event_id) DO NOTHING
+"""
+
+
+class EventClaim:
+    """Claims webhook event ids so that a retried delivery is a no-op."""
+
+    def __init__(self, pool: Pool) -> None:
+        self._pool = pool
+
+    def claim(self, event_id: str, provider: str = "stripe") -> bool:
+        """Return True when this delivery is the first to claim event_id.
+
+        The insert is the lock. webhook_events.event_id is unique, so of
+        two concurrent deliveries exactly one inserts a row and the other
+        sees rowcount 0 without blocking.
+        """
+        with self._pool.connection() as conn:
+            claimed = conn.execute(_CLAIM, (event_id, provider)).rowcount == 1
+
+        if not claimed:
+            log.info(
+                "webhook.duplicate_delivery",
+                extra={"event_id": event_id, "provider": provider},
+            )
+        return claimed

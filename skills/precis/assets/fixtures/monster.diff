diff --git a/config/http.yaml b/config/http.yaml
new file mode 100644
index 0000000..8fce3d0
--- /dev/null
+++ b/config/http.yaml
@@ -0,0 +1,31 @@
+# Outbound HTTP behaviour. Read at boot.
+#
+# max_attempts counts the first try, so 3 means one call and two retries.
+
+default:
+  timeout_seconds: 15
+  max_attempts: 3
+  base_delay_seconds: 0.5
+  cap_seconds: 30
+
+services:
+  payments:
+    timeout_seconds: 15
+    max_attempts: 3
+    base_delay_seconds: 0.5
+    cap_seconds: 20
+  shipping:
+    timeout_seconds: 20
+    max_attempts: 4
+    base_delay_seconds: 1.0
+    cap_seconds: 30
+  tax:
+    timeout_seconds: 10
+    max_attempts: 3
+    base_delay_seconds: 0.25
+    cap_seconds: 10
+  notifications:
+    timeout_seconds: 8
+    max_attempts: 5
+    base_delay_seconds: 0.5
+    cap_seconds: 15

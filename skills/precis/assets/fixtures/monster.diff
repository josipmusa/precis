new file mode 100644
index 0000000..34ffe52
--- /dev/null
+++ b/src/meridian/http/client.py
@@ -0,0 +1,91 @@
+"""The one HTTP client every outbound integration uses.
+
+Replaces four hand-maintained `_http.py` wrappers. Behaviour that used to
+differ per package is now decided here, once, from config/http.yaml.
+"""
+from __future__ import annotations
+
+import logging
+import time
+from dataclasses import dataclass
+
+import requests
+from requests import exceptions as rex
+
+from meridian.config import http_config
+from meridian.http import backoff
+
+log = logging.getLogger(__name__)
+
+RETRY_STATUSES = frozenset({408, 425, 429, 500, 502, 503, 504})
+RETRY_EXCEPTIONS = (rex.ConnectionError, rex.Timeout, rex.ChunkedEncodingError)
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    max_attempts: int
+    base_delay_seconds: float
+    cap_seconds: float
+
+    @classmethod
+    def for_service(cls, service: str) -> "RetryPolicy":
+        cfg = http_config.services.get(service, http_config.default)
+        return cls(
+            max_attempts=cfg.max_attempts,
+            base_delay_seconds=cfg.base_delay_seconds,
+            cap_seconds=cfg.cap_seconds,
+        )
+
+
+class HttpClient:
+    def __init__(self, service: str, base_url: str, session=None) -> None:
+        self._service = service
+        self._base_url = base_url.rstrip("/")
+        self._session = session or requests.Session()
+        self._policy = RetryPolicy.for_service(service)
+
+    def post_json(self, path: str, payload: dict, timeout: int | None = None) -> dict:
+        return self._request("POST", path, json=payload, timeout=timeout)
+
+    def get_json(self, path: str, timeout: int | None = None) -> dict:
+        return self._request("GET", path, timeout=timeout)
+
+    def _request(self, method: str, path: str, timeout: int | None = None, **kwargs) -> dict:
+        url = self._base_url + path
+        timeout = timeout or http_config.default.timeout_seconds
+        last_error: Exception | None = None
+
+        for attempt in range(1, self._policy.max_attempts + 1):
+            try:
+                response = self._session.request(method, url, timeout=timeout, **kwargs)
+            except RETRY_EXCEPTIONS as exc:
+                last_error = exc
+                if attempt == self._policy.max_attempts:
+                    raise
+                self._wait(attempt, reason=type(exc).__name__, path=path)
+                continue
+
+            if response.status_code in RETRY_STATUSES and attempt < self._policy.max_attempts:
+                self._wait(attempt, reason=str(response.status_code), path=path)
+                continue
+
+            response.raise_for_status()
+            return response.json()
+
+        raise RuntimeError("retry loop exhausted") from last_error
+
+    def _wait(self, attempt: int, reason: str, path: str) -> None:
+        delay = backoff.decorrelated_jitter(
+            self._policy.base_delay_seconds, attempt, self._policy.cap_seconds
+        )
+        log.warning(
+            "http.retry",
+            extra={
+                "service": self._service,
+                "path": path,
+                "reason": reason,
+                "attempt": attempt,
+                "delay_seconds": round(delay, 3),
+            },
+        )
+        time.sleep(delay)

 def fixed(delay_seconds: float, attempt: int) -> float:
     """Always wait the same amount."""
@@ -15,3 +17,13 @@ def linear(delay_seconds: float, attempt: int) -> float:
 def exponential(delay_seconds: float, attempt: int, cap: float = 30.0) -> float:
     """Double the wait each attempt, up to cap."""
     return min(delay_seconds * (2 ** (attempt - 1)), cap)
+
+
+def decorrelated_jitter(delay_seconds: float, attempt: int, cap: float = 30.0) -> float:
+    """Exponential backoff with full jitter.
+
+    Spreads a thundering herd: every caller picks a delay uniformly from
+    [0, exponential(attempt)] instead of all waking at the same instant.
+    """
+    ceiling = exponential(delay_seconds, attempt, cap)
+    return random.uniform(0.0, ceiling)

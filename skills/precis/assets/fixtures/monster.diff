diff --git a/tests/http/test_client.py b/tests/http/test_client.py
new file mode 100644
index 0000000..c237e23
--- /dev/null
+++ b/tests/http/test_client.py
@@ -0,0 +1,57 @@
+import pytest
+import requests
+
+from meridian.http.client import HttpClient, RetryPolicy
+from third_party.httpstub import StubResponse, StubTransport
+
+
+@pytest.fixture()
+def policy(monkeypatch):
+    monkeypatch.setattr(
+        RetryPolicy, "for_service",
+        classmethod(lambda cls, service: cls(max_attempts=3, base_delay_seconds=0.0, cap_seconds=0.0)),
+    )
+
+
+def client_with(responses):
+    return HttpClient("payments", "https://payments.invalid", session=StubTransport(responses))
+
+
+def test_returns_the_first_successful_body(policy):
+    client = client_with([StubResponse(200, {"ok": True})])
+
+    assert client.post_json("/v2/authorizations", {"amount": 100}) == {"ok": True}
+
+
+def test_retries_a_503_and_succeeds(policy):
+    client = client_with([StubResponse(503), StubResponse(200, {"ok": True})])
+
+    assert client.post_json("/v2/authorizations", {}) == {"ok": True}
+    assert len(client._session.requests) == 2
+
+
+def test_retries_a_connection_error(policy):
+    client = client_with([requests.exceptions.ConnectionError(), StubResponse(200, {"ok": True})])
+
+    assert client.get_json("/v2/payouts/p_1") == {"ok": True}
+
+
+def test_gives_up_after_max_attempts_and_reraises(policy):
+    client = client_with([requests.exceptions.ConnectionError()] * 3)
+
+    with pytest.raises(requests.exceptions.ConnectionError):
+        client.get_json("/v2/payouts/p_1")
+
+
+def test_does_not_retry_a_400(policy):
+    client = client_with([StubResponse(400)])
+
+    with pytest.raises(AssertionError):
+        client.post_json("/v2/authorizations", {})
+    assert len(client._session.requests) == 1
+
+
+def test_retries_a_429(policy):
+    client = client_with([StubResponse(429), StubResponse(200, {"ok": True})])
+
+    assert client.post_json("/v2/authorizations", {}) == {"ok": True}
